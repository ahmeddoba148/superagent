/* @replace ensureV128Schema */
async function ensureV128Schema(env){
  const stmts=[
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_mutation_tx(operation_id TEXT PRIMARY KEY,chat_id TEXT NOT NULL,state TEXT NOT NULL DEFAULT 'applying',started_at TEXT NOT NULL,committed_at TEXT,rolled_back_at TEXT,error_text TEXT)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_mutation_tx_state ON sanad_mutation_tx(state,started_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_mutation_journal(operation_id TEXT NOT NULL,seq INTEGER NOT NULL,chat_id TEXT NOT NULL,tool TEXT NOT NULL,state TEXT NOT NULL,before_json TEXT NOT NULL DEFAULT '{}',after_json TEXT NOT NULL DEFAULT '{}',error_text TEXT,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,PRIMARY KEY(operation_id,seq))`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_mutation_journal_chat ON sanad_mutation_journal(chat_id,created_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_delivery_queue(delivery_key TEXT PRIMARY KEY,chat_id TEXT NOT NULL,kind TEXT NOT NULL,payload_text TEXT NOT NULL,keyboard_json TEXT NOT NULL DEFAULT 'null',effect_json TEXT NOT NULL DEFAULT '{}',state TEXT NOT NULL DEFAULT 'pending',attempts INTEGER NOT NULL DEFAULT 0,lease_until TEXT,last_error TEXT,next_retry_at TEXT,telegram_message_id INTEGER,duplicate_risk INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,sent_at TEXT)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_delivery_due ON sanad_delivery_queue(state,next_retry_at,created_at)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_delivery_chat ON sanad_delivery_queue(chat_id,state,created_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_scheduler_cycles(cycle_id TEXT PRIMARY KEY,cycle_start_ms INTEGER NOT NULL,cycle_end_ms INTEGER NOT NULL,user_cursor TEXT NOT NULL DEFAULT '',watch_cursor INTEGER NOT NULL DEFAULT 0,state TEXT NOT NULL DEFAULT 'active',round_failures INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,completed_at TEXT)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_scheduler_cycles_state ON sanad_scheduler_cycles(state,created_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_dead_letters(update_id TEXT PRIMARY KEY,chat_id TEXT NOT NULL,payload_json TEXT NOT NULL,last_error TEXT NOT NULL,attempts INTEGER NOT NULL,replay_count INTEGER NOT NULL DEFAULT 0,state TEXT NOT NULL DEFAULT 'dead',next_replay_at TEXT,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,last_replayed_at TEXT)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_dead_letters_due ON sanad_dead_letters(state,next_replay_at,updated_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_operation_metrics(operation_id TEXT PRIMARY KEY,chat_id TEXT NOT NULL,total_ms INTEGER NOT NULL,context_ms INTEGER NOT NULL DEFAULT 0,planning_ms INTEGER NOT NULL DEFAULT 0,tools_ms INTEGER NOT NULL DEFAULT 0,verification_ms INTEGER NOT NULL DEFAULT 0,compose_ms INTEGER NOT NULL DEFAULT 0,d1_queries INTEGER NOT NULL DEFAULT 0,ai_calls INTEGER NOT NULL DEFAULT 0,tool_calls INTEGER NOT NULL DEFAULT 0,context_bytes INTEGER NOT NULL DEFAULT 0,budget_json TEXT NOT NULL DEFAULT '{}',budget_exceeded INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_operation_metrics_chat ON sanad_operation_metrics(chat_id,created_at)`)
  ];
  await env.DB.batch(stmts);
  await ensureColumnV125(env,'sanad_scheduler_cycles','lease_owner','TEXT');
  await ensureColumnV125(env,'sanad_scheduler_cycles','lease_until','TEXT');
  const active=(await env.DB.prepare(`SELECT cycle_id FROM sanad_scheduler_cycles WHERE state='active' ORDER BY created_at,cycle_id`).all())?.results||[];
  if(active.length>1){
    const keep=String(active[0].cycle_id),now=nowIso();
    await env.DB.prepare(`UPDATE sanad_scheduler_cycles SET state='superseded',completed_at=COALESCE(completed_at,?),updated_at=?,lease_owner=NULL,lease_until=NULL WHERE state='active' AND cycle_id<>?`).bind(now,now,keep).run();
  }
  await env.DB.prepare(`CREATE UNIQUE INDEX IF NOT EXISTS uq_sanad_scheduler_single_active ON sanad_scheduler_cycles(state) WHERE state='active'`).run();
}
/* @end */

/* @replace executeTool */
async function executeTool(env,{chatId,operationId,stepKey,tool,args,user}){
  const m=metricV128(env);
  if(m){m.tool_calls++;if(m.tool_calls>m.budget.maxTools){m.budget_exceeded=true;return{ok:false,changed:0,verified:false,error:'performance_budget_tool_calls'}}}
  const spec=TOOL_SPECS[tool],fp=spec?.mutation?mutationFingerprintV127(tool,args):null,fpKey=fp?`mutation-fp:${fnv64V127(fp)}`:null;
  const prior=await env.DB.prepare(`SELECT result_json FROM sanad_receipts WHERE operation_id=? AND step_key=?`).bind(operationId,stepKey).first();
  if(prior){try{const saved=JSON.parse(prior.result_json);if(!spec?.mutation||await verifyMutationPostconditionV127(env,chatId,tool,args,saved))return saved}catch(e){await reportFailure(env,chatId,'receipt_reverify',e,{operationId,stepKey,tool})}}
  if(fpKey){const p=await env.DB.prepare(`SELECT result_json FROM sanad_receipts WHERE operation_id=? AND step_key=?`).bind(operationId,fpKey).first();if(p){try{const saved=JSON.parse(p.result_json);if(saved?.ok&&saved?.verified)return{ok:true,changed:0,verified:true,deduplicated:true,original_changed:Number(saved.changed||0),fingerprint:fp}}catch(e){await reportFailure(env,chatId,'mutation_dedupe_receipt',e,{operationId,tool})}}}
  if(spec?.mutation){const pre=await preflightMutationIdsV127(env,chatId,tool,args);if(pre){await env.DB.prepare(`INSERT OR REPLACE INTO sanad_receipts(operation_id,step_key,chat_id,tool,result_json,created_at) VALUES(?,?,?,?,?,?)`).bind(operationId,stepKey,chatId,tool,JSON.stringify(pre),nowIso()).run();return pre}}
  const created=nowIso();let seq=0,before={};
  if(spec?.mutation){
    try{before=await snapshotUserStateV125(env,chatId,[{tool,args}])}catch(e){await reportFailure(env,chatId,'journal_before',e,{operationId,tool});return{ok:false,changed:0,verified:false,error:'mutation_snapshot_failed'}}
    try{seq=await prepareMutationJournalV1281(env,operationId,chatId,tool,before,created)}catch(e){await reportFailure(env,chatId,'journal_prepare',e,{operationId,tool});return{ok:false,changed:0,verified:false,error:'mutation_journal_prepare_failed'}}
  }
  const toolStart=Date.now();let result;
  try{result=await dispatchTool(env,chatId,tool,args,user)}catch(e){result={ok:false,changed:0,verified:false,error:safeError(e),retryable:true}}
  if(m)m.tools_ms+=Date.now()-toolStart;
  if(spec?.mutation&&result?.ok===true){const vs=Date.now();let verified=false;try{verified=await verifyMutationPostconditionV127(env,chatId,tool,args,result)}catch(e){await reportFailure(env,chatId,'mutation_verify',e,{tool,args})}if(m)m.verification_ms+=Date.now()-vs;result=verified?{...result,verified:true}:{...result,ok:false,verified:false,error:'mutation_postcondition_failed'}}
  const now=nowIso(),rr=env.DB.prepare(`INSERT OR REPLACE INTO sanad_receipts(operation_id,step_key,chat_id,tool,result_json,created_at) VALUES(?,?,?,?,?,?)`).bind(operationId,stepKey,chatId,tool,JSON.stringify(result).slice(0,15000),now),batch=[rr];
  if(spec?.mutation)batch.unshift(env.DB.prepare(`UPDATE sanad_mutation_journal SET state=?,after_json=?,error_text=?,updated_at=? WHERE operation_id=? AND seq=?`).bind(result?.ok&&result?.verified?'applied':'failed',JSON.stringify(result?.after??result??{}).slice(0,50000),result?.ok?null:String(result?.error||'failed'),now,operationId,seq));
  if(fpKey&&result?.ok&&result?.verified&&Number(result?.changed||0)>0)batch.push(env.DB.prepare(`INSERT OR IGNORE INTO sanad_receipts(operation_id,step_key,chat_id,tool,result_json,created_at) VALUES(?,?,?,?,?,?)`).bind(operationId,fpKey,chatId,tool,JSON.stringify(result).slice(0,15000),now));
  await env.DB.batch(batch);
  return result;
}
/* @end */

/* @replace activeSchedulerCycleV128 */
async function activeSchedulerCycleV128(env,scheduledTime){
  const existing=await env.DB.prepare(`SELECT * FROM sanad_scheduler_cycles WHERE state='active' ORDER BY created_at,cycle_id LIMIT 1`).first();
  if(existing)return existing;
  const end=Number(scheduledTime||Date.now()),lr=await env.DB.prepare(`SELECT value FROM sanad_scheduler_state WHERE key='last_run_ms'`).first(),start=Math.max(end-SCHEDULER_CATCHUP_MINUTES*60000,Number(lr?.value||end-60000)),id=`cycle:${start}:${end}:${crypto.randomUUID()}`,now=nowIso();
  await env.DB.prepare(`INSERT OR IGNORE INTO sanad_scheduler_cycles(cycle_id,cycle_start_ms,cycle_end_ms,user_cursor,watch_cursor,state,lease_owner,lease_until,created_at,updated_at) VALUES(?,?,?,'',0,'active',NULL,NULL,?,?)`).bind(id,start,end,now,now).run();
  const row=await env.DB.prepare(`SELECT * FROM sanad_scheduler_cycles WHERE state='active' ORDER BY created_at,cycle_id LIMIT 1`).first();
  if(!row)throw new Error('scheduler_cycle_acquire_failed');
  return row;
}
/* @end */

/* @replace runSanadScheduler */
async function runSanadScheduler(env,scheduledTime){
  await ensureV128Schema(env);await recoverStaleMutationTxV128(env);
  const base=await activeSchedulerCycleV128(env,scheduledTime),claim=await claimSchedulerCycleV1281(env,String(base.cycle_id));
  if(!claim)return{ok:true,complete:false,skipped:true,reason:'cycle_busy',cycle_id:String(base.cycle_id)};
  const c=claim.row,owner=claim.owner;let cursor=String(c.user_cursor||''),usersComplete=false,roundOk=true,blockedByTx=false;
  outer:for(let page=0;page<V128_USER_PAGES_PER_RUN;page++){
    const rows=await schedulerUserPageV128(env,cursor,V128_USER_PAGE_SIZE);
    if(!rows.length){usersComplete=true;cursor='';break}
    for(const u of rows){
      if(Number(u.__tx_active||0)){blockedByTx=true;break outer}
      const previous=cursor;
      try{
        await deliverUserScheduleV125(env,u,Number(c.cycle_start_ms),Number(c.cycle_end_ms));
        await deliverPrayerRulesV125(env,u,Number(c.cycle_start_ms),Number(c.cycle_end_ms));
        await deliverDailyBriefsV125(env,u,Number(c.cycle_start_ms),Number(c.cycle_end_ms));
        if(Number(u.proactive_enabled??1))await proactiveUserV125(env,u);
        cursor=String(u.chat_id);
      }catch(e){roundOk=false;cursor=previous;await reportFailure(env,String(u.chat_id),'scheduler_user',e,{cycle_id:c.cycle_id,window_start:c.cycle_start_ms,window_end:c.cycle_end_ms});break outer}
    }
    if(rows.length<V128_USER_PAGE_SIZE){usersComplete=true;cursor='';break}
  }
  let watch={ok:true,complete:false,cursor:Number(c.watch_cursor||0)};
  if(usersComplete&&!blockedByTx&&roundOk)watch=await checkLiveWatchesV125(env,c);
  if(!watch.ok)roundOk=false;
  await processDeliveryQueueV128(env,V128_DELIVERY_BATCH);
  const done=usersComplete&&!blockedByTx&&watch.complete&&roundOk,now=nowIso();
  if(done){
    const closed=await env.DB.prepare(`UPDATE sanad_scheduler_cycles SET state='complete',user_cursor='',watch_cursor=0,completed_at=?,updated_at=?,lease_owner=NULL,lease_until=NULL WHERE cycle_id=? AND state='active' AND lease_owner=? RETURNING cycle_id`).bind(now,now,String(c.cycle_id),owner).first();
    if(!closed)throw new Error('scheduler_cycle_lease_lost');
    await env.DB.prepare(`INSERT INTO sanad_scheduler_state(key,value,updated_at) VALUES('last_run_ms',?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at`).bind(String(c.cycle_end_ms),now).run();
  }else{
    const updated=await env.DB.prepare(`UPDATE sanad_scheduler_cycles SET user_cursor=?,watch_cursor=?,round_failures=round_failures+?,updated_at=?,lease_owner=NULL,lease_until=NULL WHERE cycle_id=? AND state='active' AND lease_owner=? RETURNING cycle_id`).bind(cursor,usersComplete?Number(watch.cursor||0):Number(c.watch_cursor||0),roundOk?0:1,now,String(c.cycle_id),owner).first();
    if(!updated)throw new Error('scheduler_cycle_lease_lost');
  }
  return{ok:done,complete:done,blocked_by_active_tx:blockedByTx,cycle_id:c.cycle_id,cycle_start_ms:Number(c.cycle_start_ms),cycle_end_ms:Number(c.cycle_end_ms),user_cursor:cursor,watch_cursor:Number(watch.cursor||0)};
}
/* @end */

/* @append */
async function prepareMutationJournalV1281(env,operationId,chatId,tool,before,created=nowIso()){
  const beforeJson=JSON.stringify(before).slice(0,50000);
  for(let attempt=0;attempt<4;attempt++){
    try{
      const res=await env.DB.batch([
        env.DB.prepare(`INSERT OR IGNORE INTO sanad_mutation_tx(operation_id,chat_id,state,started_at) VALUES(?,?, 'applying',?)`).bind(String(operationId),String(chatId),created),
        env.DB.prepare(`INSERT INTO sanad_mutation_journal(operation_id,seq,chat_id,tool,state,before_json,after_json,error_text,created_at,updated_at) SELECT ?,COALESCE(MAX(seq),0)+1,?,?,'prepared',?,'{}',NULL,?,? FROM sanad_mutation_journal WHERE operation_id=? RETURNING seq`).bind(String(operationId),String(chatId),String(tool),beforeJson,created,created,String(operationId))
      ]);
      let seq=Number(res?.[1]?.results?.[0]?.seq||0);
      if(!seq){const row=await env.DB.prepare(`SELECT seq FROM sanad_mutation_journal WHERE operation_id=? ORDER BY seq DESC LIMIT 1`).bind(String(operationId)).first();seq=Number(row?.seq||0)}
      if(seq>0)return seq;
      throw new Error('journal_seq_not_returned');
    }catch(e){
      if(attempt>=3||!/unique|constraint|journal_seq_not_returned/i.test(safeError(e)))throw e;
      await sleep(5*(attempt+1));
    }
  }
  throw new Error('journal_seq_allocation_failed');
}

async function claimSchedulerCycleV1281(env,cycleId){
  const owner=`scheduler-${crypto.randomUUID()}`,now=nowIso(),until=new Date(Date.now()+15*60000).toISOString();
  const row=await env.DB.prepare(`UPDATE sanad_scheduler_cycles SET lease_owner=?,lease_until=?,updated_at=? WHERE cycle_id=? AND state='active' AND (lease_owner IS NULL OR lease_until IS NULL OR lease_until<=?) RETURNING *`).bind(owner,until,now,String(cycleId),now).first();
  return row?{owner,row}:null;
}

async function deepSelftestV1281(env){
  const tests=[];const add=(name,ok,detail='')=>tests.push({name,ok:!!ok,detail:String(detail??'')});
  const chat='__sanad_v1281_hotfix__',op=`v1281:${crypto.randomUUID()}`;
  try{
    await ensureSchema(env);
    await env.DB.batch([env.DB.prepare(`DELETE FROM sanad_mutation_journal WHERE operation_id=?`).bind(op),env.DB.prepare(`DELETE FROM sanad_mutation_tx WHERE operation_id=?`).bind(op)]);
    const seqs=await Promise.all([prepareMutationJournalV1281(env,op,chat,'test.a',{},nowIso()),prepareMutationJournalV1281(env,op,chat,'test.b',{},nowIso())]);
    const jr=(await env.DB.prepare(`SELECT seq FROM sanad_mutation_journal WHERE operation_id=? ORDER BY seq`).bind(op).all())?.results||[];
    add('mutation journal seq atomic and unique',jr.length===2&&Number(jr[0].seq)===1&&Number(jr[1].seq)===2&&new Set(seqs.map(Number)).size===2,JSON.stringify({seqs,rows:jr}));

    const marker=`CTX_END_${crypto.randomUUID()}`,prompt=brainSystemPrompt({payload:'x'.repeat(31000)+marker});
    add('brain context is not arbitrary 28k sliced',prompt.includes(marker),String(prompt.length));

    const now=nowIso();await env.DB.prepare(`UPDATE sanad_scheduler_cycles SET state='complete',completed_at=COALESCE(completed_at,?),updated_at=?,lease_owner=NULL,lease_until=NULL WHERE state='active'`).bind(now,now).run();
    const tick=Date.now(),cycles=await Promise.all([activeSchedulerCycleV128(env,tick),activeSchedulerCycleV128(env,tick)]),activeCount=Number((await env.DB.prepare(`SELECT COUNT(*) c FROM sanad_scheduler_cycles WHERE state='active'`).first())?.c||0);
    add('scheduler cycle creation race closed',activeCount===1&&String(cycles[0]?.cycle_id)===String(cycles[1]?.cycle_id),JSON.stringify({activeCount,ids:cycles.map(x=>x?.cycle_id)}));
    const claims=await Promise.all([claimSchedulerCycleV1281(env,String(cycles[0].cycle_id)),claimSchedulerCycleV1281(env,String(cycles[0].cycle_id))]);
    add('scheduler cycle execution lease single owner',claims.filter(Boolean).length===1,JSON.stringify(claims.map(x=>!!x)));
    const winner=claims.find(Boolean);if(winner)await env.DB.prepare(`UPDATE sanad_scheduler_cycles SET state='complete',completed_at=?,updated_at=?,lease_owner=NULL,lease_until=NULL WHERE cycle_id=? AND lease_owner=?`).bind(nowIso(),nowIso(),String(cycles[0].cycle_id),winner.owner).run();
  }catch(e){add('v12.8.1 selftest exception',false,safeError(e))}
  finally{try{await env.DB.batch([env.DB.prepare(`DELETE FROM sanad_mutation_journal WHERE operation_id=?`).bind(op),env.DB.prepare(`DELETE FROM sanad_mutation_tx WHERE operation_id=?`).bind(op)])}catch{}}
  return{ok:tests.every(x=>x.ok),version:'12.8.1',tests};
}
