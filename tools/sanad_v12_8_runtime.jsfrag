/* ================= SANAD V12.8 ATOMIC RUNTIME ================= */
const V128_DELIVERY_BATCH=80;
const V128_DELIVERY_LEASE_MS=45000;
const V128_USER_PAGE_SIZE=250;
const V128_USER_PAGES_PER_RUN=5;
const V128_WATCH_PAGE_SIZE=100;
const V128_WATCH_PAGES_PER_RUN=4;
const V128_DLQ_AUTO_REPLAYS=2;
const V128_TX_STALE_MS=120000;
const V128_CONTEXT_MAX_BYTES_SIMPLE=26000;
const V128_CONTEXT_MAX_BYTES_COMPLEX=70000;

async function ensureV128Schema(env){
  const stmts=[
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_mutation_tx(operation_id TEXT PRIMARY KEY,chat_id TEXT NOT NULL,state TEXT NOT NULL DEFAULT 'applying',started_at TEXT NOT NULL,committed_at TEXT,rolled_back_at TEXT,error_text TEXT)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_mutation_tx_state ON sanad_mutation_tx(state,started_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_mutation_journal(operation_id TEXT NOT NULL,seq INTEGER NOT NULL,chat_id TEXT NOT NULL,tool TEXT NOT NULL,state TEXT NOT NULL,before_json TEXT NOT NULL DEFAULT '{}',after_json TEXT NOT NULL DEFAULT '{}',error_text TEXT,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,PRIMARY KEY(operation_id,seq))`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_mutation_journal_chat ON sanad_mutation_journal(chat_id,created_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_delivery_queue(delivery_key TEXT PRIMARY KEY,chat_id TEXT NOT NULL,kind TEXT NOT NULL,payload_text TEXT NOT NULL,keyboard_json TEXT NOT NULL DEFAULT 'null',effect_json TEXT NOT NULL DEFAULT '{}',state TEXT NOT NULL DEFAULT 'pending',attempts INTEGER NOT NULL DEFAULT 0,lease_until TEXT,last_error TEXT,next_retry_at TEXT,telegram_message_id INTEGER,duplicate_risk INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,sent_at TEXT)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_delivery_due ON sanad_delivery_queue(state,next_retry_at,created_at)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_delivery_chat ON sanad_delivery_queue(chat_id,state,created_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_scheduler_cycles(cycle_id TEXT PRIMARY KEY,cycle_start_ms INTEGER NOT NULL,cycle_end_ms INTEGER NOT NULL,user_cursor TEXT NOT NULL DEFAULT '',watch_cursor INTEGER NOT NULL DEFAULT 0,state TEXT NOT NULL DEFAULT 'active',round_failures INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,completed_at TEXT)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_scheduler_cycles_state ON sanad_scheduler_cycles(state,created_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_dead_letters(update_id TEXT PRIMARY KEY,chat_id TEXT NOT NULL,payload_json TEXT NOT NULL,last_error TEXT NOT NULL,attempts INTEGER NOT NULL,replay_count INTEGER NOT NULL DEFAULT 0,state TEXT NOT NULL DEFAULT 'dead',next_replay_at TEXT,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,last_replayed_at TEXT)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_dead_letters_due ON sanad_dead_letters(state,next_replay_at,updated_at)`),
    env.DB.prepare(`CREATE TABLE IF NOT EXISTS sanad_operation_metrics(operation_id TEXT PRIMARY KEY,chat_id TEXT NOT NULL,total_ms INTEGER NOT NULL,context_ms INTEGER NOT NULL DEFAULT 0,planning_ms INTEGER NOT NULL DEFAULT 0,tools_ms INTEGER NOT NULL DEFAULT 0,verification_ms INTEGER NOT NULL DEFAULT 0,compose_ms INTEGER NOT NULL DEFAULT 0,d1_queries INTEGER NOT NULL DEFAULT 0,ai_calls INTEGER NOT NULL DEFAULT 0,tool_calls INTEGER NOT NULL DEFAULT 0,context_bytes INTEGER NOT NULL DEFAULT 0,budget_json TEXT NOT NULL DEFAULT '{}',budget_exceeded INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL)`),
    env.DB.prepare(`CREATE INDEX IF NOT EXISTS idx_sanad_operation_metrics_chat ON sanad_operation_metrics(chat_id,created_at)`)
  ];
  await env.DB.batch(stmts);
}

async function ensureSchema(env,force=false){await ensureSchemaCore(env,force);await ensureV128Schema(env);}

function v128Budget(text){
  const t=normalizeText(text),complex=t.length>180||/[،,؛;].{2,}[،,؛;]/u.test(t)||/(?:كل|جميع|مع بعض|وبعدين|وبعدها|وفي نفس الوقت)/u.test(t);
  return complex?{simple:false,maxD1:90,maxAi:5,maxTools:14,maxContext:V128_CONTEXT_MAX_BYTES_COMPLEX}:{simple:true,maxD1:32,maxAi:2,maxTools:7,maxContext:V128_CONTEXT_MAX_BYTES_SIMPLE};
}
function metricV128(env){return env&&env.__v128Metrics||null;}
const rawStmtV128=new WeakMap();
function meteredStmtV128(stmt,m){
  const w={
    bind(...args){return meteredStmtV128(stmt.bind(...args),m)},
    async run(...args){m.d1_queries++;return stmt.run(...args)},
    async all(...args){m.d1_queries++;return stmt.all(...args)},
    async first(...args){m.d1_queries++;return stmt.first(...args)},
    async raw(...args){m.d1_queries++;return stmt.raw(...args)}
  };rawStmtV128.set(w,stmt);return w;
}
function meteredDbV128(db,m){
  return{
    prepare(sql){return meteredStmtV128(db.prepare(sql),m)},
    async batch(stmts){m.d1_queries+=Array.isArray(stmts)?stmts.length:1;return db.batch((stmts||[]).map(s=>rawStmtV128.get(s)||s))},
    async exec(sql){m.d1_queries+=Math.max(1,String(sql||'').split(';').filter(x=>x.trim()).length);return db.exec(sql)},
    withSession(bookmark){if(!db.withSession)return undefined;return meteredDbV128(db.withSession(bookmark),m)}
  };
}
async function persistOperationMetricsV128(env,m){
  try{await env.DB.prepare(`INSERT OR REPLACE INTO sanad_operation_metrics(operation_id,chat_id,total_ms,context_ms,planning_ms,tools_ms,verification_ms,compose_ms,d1_queries,ai_calls,tool_calls,context_bytes,budget_json,budget_exceeded,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).bind(m.operationId,m.chatId,m.total_ms||0,m.context_ms||0,m.planning_ms||0,m.tools_ms||0,m.verification_ms||0,m.compose_ms||0,m.d1_queries||0,m.ai_calls||0,m.tool_calls||0,m.context_bytes||0,JSON.stringify(m.budget||{}),m.budget_exceeded?1:0,nowIso()).run()}catch(e){console.error('operation_metrics',e)}
}
async function recoverChatTransactionsV128(env,chatId){
  const cutoff=new Date(Date.now()-V128_TX_STALE_MS).toISOString(),rows=(await env.DB.prepare(`SELECT t.operation_id,s.snapshot_json FROM sanad_mutation_tx t JOIN sanad_operation_snapshots s ON s.operation_id=t.operation_id AND s.chat_id=t.chat_id WHERE t.chat_id=? AND t.state='applying' AND t.started_at<? ORDER BY t.started_at LIMIT 3`).bind(String(chatId),cutoff).all())?.results||[];
  for(const r of rows){try{const snap=parseJsonV125(r.snapshot_json,{});const rr=await restoreUserStateVerifiedV127(env,chatId,snap,true);if(!rr.verified)throw new Error('stale_tx_restore_unverified');await env.DB.batch([env.DB.prepare(`UPDATE sanad_mutation_tx SET state='rolled_back',rolled_back_at=?,error_text='stale_recovery' WHERE operation_id=?`).bind(nowIso(),String(r.operation_id)),env.DB.prepare(`UPDATE sanad_mutation_journal SET state='rolled_back',updated_at=? WHERE operation_id=? AND state='applied'`).bind(nowIso(),String(r.operation_id))]);}catch(e){await reportFailure(env,chatId,'stale_mutation_recovery',e,{operation_id:r.operation_id})}}
}
async function runAgent(env,args){
  await ensureV128Schema(env);await recoverChatTransactionsV128(env,args.chatId);
  const started=Date.now(),budget=v128Budget(args.text),m={operationId:String(args.operationId||crypto.randomUUID()),chatId:String(args.chatId),started,context_ms:0,planning_ms:0,tools_ms:0,verification_ms:0,compose_ms:0,d1_queries:0,ai_calls:0,tool_calls:0,context_bytes:0,budget,budget_exceeded:false,total_ms:0};
  const e={...env,DB:meteredDbV128(env.DB,m),__v128Metrics:m};
  try{return await runAgentCore(e,args)}finally{m.total_ms=Date.now()-started;m.budget_exceeded=m.d1_queries>budget.maxD1||m.ai_calls>budget.maxAi||m.tool_calls>budget.maxTools||m.context_bytes>budget.maxContext;await persistOperationMetricsV128(env,m);}
}
async function callBrainJson(env,system,userText,deadline){const m=metricV128(env),s=Date.now();if(m){if(m.ai_calls>=m.budget.maxAi){m.budget_exceeded=true;throw new Error('performance_budget_ai_calls')}m.ai_calls++;}try{return await callBrainJsonCore(env,system,userText,deadline)}finally{if(m)m.planning_ms+=Date.now()-s;}}
async function callBrainText(env,messagesOrSystem,deadlineMaybe){const m=metricV128(env),s=Date.now();if(m){if(m.ai_calls>=m.budget.maxAi){m.budget_exceeded=true;throw new Error('performance_budget_ai_calls')}m.ai_calls++;}try{return await callBrainTextCore(env,messagesOrSystem,deadlineMaybe)}finally{if(m)m.compose_ms+=Date.now()-s;}}

function tokensV128(text){return new Set(normItem(text).split(/[^\p{L}\p{N}]+/u).filter(x=>x.length>1));}
function trigramsV128(text){const s=normItem(text).replace(/\s+/g,' '),out=new Set();for(let i=0;i<Math.max(0,s.length-2);i++)out.add(s.slice(i,i+3));return out;}
function jaccardV128(a,b){if(!a.size||!b.size)return 0;let n=0;for(const x of a)if(b.has(x))n++;return n/(a.size+b.size-n);}
function semanticSimilarityV128(a,b){return 0.62*jaccardV128(tokensV128(a),tokensV128(b))+0.38*jaccardV128(trigramsV128(a),trigramsV128(b));}
function recencyScoreV128(value){const ms=Date.parse(String(value||''));if(!Number.isFinite(ms))return 0;const days=Math.max(0,(Date.now()-ms)/86400000);return Math.exp(-days/30);}
function domainScoresV128(text){
  const t=normItem(text),defs={shopping:['مشتريات','اشتري','شراء','السوبر','لبن','رز','قائمه'],schedule:['موعد','مواعيد','ذكرني','تذكير','الجدول','فاضي','ميعاد','بكره','الاسبوع'],projects:['مشروع','مهمه','تاسك','انجاز','تقدم'],waiting:['مستني','متابعه','رد','يرد','انتظار'],memory:['فاكر','افتكر','تذكر','بحب','بفضل','معلومه عني'],world:['مين','علاقه','شخص','مكان','حقيقه'],prayer:['صلاه','الصلاه','الفجر','الظهر','العصر','المغرب','العشاء'],live:['خبر','اخبار','طقس','جو','مباشر','اخر تطورات'],inbox:['انبوكس','صندوق الوارد','سجل دي','فكره']};
  const scores=new Map();for(const [d,words] of Object.entries(defs)){let s=0;for(const w of words){const n=normItem(w);if(t.includes(n))s+=n.length>5?1.2:0.8;s+=semanticSimilarityV128(t,n)*0.35;}scores.set(d,s);}if(/\b(?:و|ثم|كمان)\b/u.test(t)){const positives=[...scores].filter(([,v])=>v>0.65);for(const [d,v] of positives)scores.set(d,v+0.2);}return scores;
}
function selectedDomainsV128(text){const s=domainScoresV128(text),ordered=[...s.entries()].sort((a,b)=>b[1]-a[1]),out=new Set(ordered.filter(([,v])=>v>=0.62).slice(0,3).map(([d])=>d));if(!out.size){out.add('memory');out.add('world');}return out;}
function rowTextV128(r){return [r.content,r.title,r.name,r.text,r.waiting_on,r.notes,r.data_json,r.meta_json].filter(Boolean).join(' ');}
function rankRowsV128(rows,q,{limit=12,importance='importance',date='updated_at'}={}){return [...rows].map(r=>{const sem=semanticSimilarityV128(q,rowTextV128(r)),imp=Math.max(0,Math.min(1,Number(r?.[importance]??0.5))),rec=recencyScoreV128(r?.[date]||r?.created_at);return{r,score:sem*0.58+imp*0.27+rec*0.15}}).sort((a,b)=>b.score-a.score).slice(0,limit).map(x=>x.r);}
async function buildContext(env,chatId,user,userText){
  const m=metricV128(env),started=Date.now(),domains=selectedDomainsV128(userText),state={shopping:[],reminders:[],recurrences:[],memories:[],entities:[],projects:[],tasks:[],waiting:[],dependencies:[],prayer_rules:[],live_watches:[],inbox:[],shopping_session:null};
  const jobs=[];
  if(domains.has('shopping'))jobs.push((async()=>{state.shopping=(await env.DB.prepare(`SELECT id,title,quantity,status,meta_json,updated_at FROM sanad_shopping WHERE chat_id=? AND status IN ('pending','bought','unavailable','skipped') ORDER BY id DESC LIMIT 80`).bind(chatId).all())?.results||[];state.shopping_session=await env.DB.prepare(`SELECT id,place_name,started_at FROM sanad_shopping_sessions WHERE chat_id=? AND ended_at IS NULL ORDER BY id DESC LIMIT 1`).bind(chatId).first();})());
  if(domains.has('schedule'))jobs.push((async()=>{state.reminders=(await env.DB.prepare(`SELECT * FROM sanad_reminders WHERE chat_id=? AND status='active' ORDER BY local_date,local_time LIMIT 120`).bind(chatId).all())?.results||[];state.recurrences=(await env.DB.prepare(`SELECT * FROM sanad_recurrences WHERE chat_id=? AND active=1 ORDER BY id DESC LIMIT 80`).bind(chatId).all())?.results||[];state.dependencies=(await env.DB.prepare(`SELECT * FROM sanad_dependencies WHERE chat_id=? AND active=1 ORDER BY id DESC LIMIT 80`).bind(chatId).all())?.results||[];})());
  if(domains.has('projects'))jobs.push((async()=>{state.projects=(await env.DB.prepare(`SELECT * FROM sanad_projects WHERE chat_id=? AND status!='done' ORDER BY id DESC LIMIT 60`).bind(chatId).all())?.results||[];state.tasks=(await env.DB.prepare(`SELECT * FROM sanad_project_tasks WHERE chat_id=? AND status!='done' ORDER BY id DESC LIMIT 100`).bind(chatId).all())?.results||[];})());
  if(domains.has('waiting'))jobs.push((async()=>{state.waiting=(await env.DB.prepare(`SELECT * FROM sanad_waiting WHERE chat_id=? AND status='waiting' ORDER BY id DESC LIMIT 60`).bind(chatId).all())?.results||[];})());
  if(domains.has('prayer'))jobs.push((async()=>{state.prayer_rules=(await env.DB.prepare(`SELECT * FROM sanad_prayer_rules WHERE chat_id=? AND active=1 ORDER BY id DESC LIMIT 50`).bind(chatId).all())?.results||[];})());
  if(domains.has('live'))jobs.push((async()=>{state.live_watches=(await env.DB.prepare(`SELECT * FROM sanad_live_watches WHERE chat_id=? AND active=1 ORDER BY id DESC LIMIT 50`).bind(chatId).all())?.results||[];})());
  if(domains.has('inbox'))jobs.push((async()=>{state.inbox=(await env.DB.prepare(`SELECT * FROM sanad_life_inbox WHERE chat_id=? AND status='open' ORDER BY id DESC LIMIT 60`).bind(chatId).all())?.results||[];})());
  jobs.push((async()=>{const rows=(await env.DB.prepare(`SELECT id,memory_type,content,importance,last_used_at,created_at,updated_at FROM sanad_memories WHERE chat_id=? ORDER BY updated_at DESC LIMIT 140`).bind(chatId).all())?.results||[];state.memories=rankRowsV128(rows,userText,{limit:14});})());
  jobs.push((async()=>{const rows=(await env.DB.prepare(`SELECT id,entity_type,name,data_json,confidence,source,created_at,updated_at FROM sanad_entities WHERE chat_id=? AND (source='user_explicit' OR confidence>=?) ORDER BY updated_at DESC LIMIT 120`).bind(chatId,V127_TRUSTED_WORLD_CONFIDENCE).all())?.results||[];state.entities=rankRowsV128(rows,userText,{limit:12,importance:'confidence'});})());
  await Promise.all(jobs);
  const convRows=(await env.DB.prepare(`SELECT id,role,content,created_at FROM sanad_conversation WHERE chat_id=? ORDER BY id DESC LIMIT 50`).bind(chatId).all())?.results||[],ranked=rankRowsV128(convRows,userText,{limit:12,importance:'__none',date:'created_at'}),latest=convRows.slice(0,6),seen=new Set(),conversation=[];for(const r of [...latest,...ranked].sort((a,b)=>Number(a.id)-Number(b.id))){if(seen.has(r.id))continue;seen.add(r.id);conversation.push(r)}
  const out={now:localNow(user?.timezone||TZ),profile:{display_name:user?.display_name||'',timezone:user?.timezone||TZ,city:user?.city||DEFAULT_CITY,country:user?.country||DEFAULT_COUNTRY,country_code:user?.country_code||'EG',latitude:user?.latitude??null,longitude:user?.longitude??null,autonomy_mode:user?.autonomy_mode||'full_safe',proactive_enabled:Number(user?.proactive_enabled??1),deep_reasoning_mode:user?.deep_reasoning_mode||'auto'},user_text:userText,retrieval:{mode:'hybrid',domains:[...domains],scores:Object.fromEntries(domainScoresV128(userText))},conversation,state};
  if(m){m.context_ms+=Date.now()-started;m.context_bytes=Buffer.byteLength(JSON.stringify(out));if(m.context_bytes>m.budget.maxContext)m.budget_exceeded=true;}return out;
}

async function beginMutationTxV128(env,chatId,operationId){await env.DB.prepare(`INSERT OR IGNORE INTO sanad_mutation_tx(operation_id,chat_id,state,started_at) VALUES(?,?, 'applying',?)`).bind(String(operationId),String(chatId),nowIso()).run();}
async function ensureOperationSnapshotV125(env,chatId,operationId,snapshot,summary){
  const now=nowIso();await env.DB.batch([env.DB.prepare(`INSERT OR IGNORE INTO sanad_mutation_tx(operation_id,chat_id,state,started_at) VALUES(?,?, 'applying',?)`).bind(String(operationId),String(chatId),now),env.DB.prepare(`INSERT OR IGNORE INTO sanad_operation_snapshots(operation_id,chat_id,snapshot_json,summary,created_at,committed) VALUES(?,?,?,?,?,0)`).bind(operationId,String(chatId),JSON.stringify(snapshot),String(summary||''),now)]);const r=await env.DB.prepare(`SELECT snapshot_json FROM sanad_operation_snapshots WHERE operation_id=? AND chat_id=?`).bind(operationId,String(chatId)).first();return r?parseJsonV125(r.snapshot_json,snapshot):snapshot;
}
async function commitOperationSnapshotV125(env,operationId){const now=nowIso();await env.DB.batch([env.DB.prepare(`UPDATE sanad_operation_snapshots SET committed=1 WHERE operation_id=?`).bind(operationId),env.DB.prepare(`UPDATE sanad_mutation_tx SET state='committed',committed_at=?,error_text=NULL WHERE operation_id=?`).bind(now,operationId),env.DB.prepare(`UPDATE sanad_mutation_journal SET state='committed',updated_at=? WHERE operation_id=? AND state='applied'`).bind(now,operationId)]);}
async function discardOperationSnapshotV125(env,operationId){await env.DB.batch([env.DB.prepare(`DELETE FROM sanad_operation_snapshots WHERE operation_id=? AND committed=0`).bind(operationId),env.DB.prepare(`UPDATE sanad_mutation_tx SET state=CASE WHEN state='applying' THEN 'rolled_back' ELSE state END,rolled_back_at=CASE WHEN state='applying' THEN ? ELSE rolled_back_at END WHERE operation_id=?`).bind(nowIso(),operationId)]);}
async function snapshotUserStateV125(env,chatId,steps=null){return snapshotUserStateLegacyV128(env,chatId,steps);}
async function buildRestoreBatchV128(env,chatId,snap){const stmts=[];for(const [table,rowsRaw] of Object.entries(snap||{})){if(!(await tableExistsV125(env,table)))throw new Error(`restore_missing_table:${table}`);stmts.push(env.DB.prepare(`DELETE FROM ${table} WHERE chat_id=?`).bind(String(chatId)));for(const row of Array.isArray(rowsRaw)?rowsRaw:[]){const cols=Object.keys(row);if(!cols.length)continue;stmts.push(env.DB.prepare(`INSERT INTO ${table}(${cols.map(sqlQuoteNameV125).join(',')}) VALUES(${cols.map(()=>'?').join(',')})`).bind(...cols.map(c=>row[c])));}}return stmts;}
async function restoreUserStateV125(env,chatId,snap){const stmts=await buildRestoreBatchV128(env,chatId,snap);if(stmts.length)await env.DB.batch(stmts);return restoreUserStateVerifiedV127(env,chatId,snap,false);}
async function restoreUserStateVerifiedV127(env,chatId,snap,performRestore=true){if(performRestore)await restoreUserStateV125(env,chatId,snap);const failures=[];for(const [table,expected] of Object.entries(snap||{})){if(!(await tableExistsV125(env,table))){failures.push(`${table}:missing_table`);continue;}const actual=(await env.DB.prepare(`SELECT * FROM ${table} WHERE chat_id=?`).bind(String(chatId)).all())?.results||[];if(JSON.stringify(canonicalRowsV127(actual))!==JSON.stringify(canonicalRowsV127(expected)))failures.push(`${table}:mismatch`);}return{ok:failures.length===0,verified:failures.length===0,failures,atomic_batch:true};}

async function executeTool(env,{chatId,operationId,stepKey,tool,args,user}){
  const m=metricV128(env),started=Date.now();if(m){m.tool_calls++;if(m.tool_calls>m.budget.maxTools){m.budget_exceeded=true;return{ok:false,changed:0,verified:false,error:'performance_budget_tool_calls'}}}
  const spec=TOOL_SPECS[tool],fp=spec?.mutation?mutationFingerprintV127(tool,args):null,fpKey=fp?`mutation-fp:${fnv64V127(fp)}`:null;
  try{
    const prior=await env.DB.prepare(`SELECT result_json FROM sanad_receipts WHERE operation_id=? AND step_key=?`).bind(operationId,stepKey).first();if(prior){try{const saved=JSON.parse(prior.result_json);if(!spec?.mutation||await verifyMutationPostconditionV127(env,chatId,tool,args,saved))return saved;}catch(e){await reportFailure(env,chatId,'receipt_reverify',e,{operationId,stepKey,tool})}}
    if(fpKey){const p=await env.DB.prepare(`SELECT result_json FROM sanad_receipts WHERE operation_id=? AND step_key=?`).bind(operationId,fpKey).first();if(p){try{const saved=JSON.parse(p.result_json);if(saved?.ok&&saved?.verified)return{ok:true,changed:0,verified:true,deduplicated:true,original_changed:Number(saved.changed||0),fingerprint:fp};}catch(e){await reportFailure(env,chatId,'mutation_dedupe_receipt',e,{operationId,tool})}}}
    if(spec?.mutation){await beginMutationTxV128(env,chatId,operationId);const pre=await preflightMutationIdsV127(env,chatId,tool,args);if(pre){await env.DB.prepare(`INSERT OR REPLACE INTO sanad_receipts(operation_id,step_key,chat_id,tool,result_json,created_at) VALUES(?,?,?,?,?,?)`).bind(operationId,stepKey,chatId,tool,JSON.stringify(pre),nowIso()).run();return pre;}}
    const seq=Number(String(stepKey).match(/(\d+)/)?.[1]||Date.now()%1000000);let before={};if(spec?.mutation)try{before=await snapshotUserStateV125(env,chatId,[{tool,args}])}catch(e){await reportFailure(env,chatId,'journal_before',e,{operationId,tool})}
    const toolStart=Date.now();let result;try{result=await dispatchTool(env,chatId,tool,args,user)}catch(e){result={ok:false,changed:0,verified:false,error:safeError(e),retryable:true}}if(m)m.tools_ms+=Date.now()-toolStart;
    if(spec?.mutation&&result?.ok===true){const vs=Date.now();let verified=false;try{verified=await verifyMutationPostconditionV127(env,chatId,tool,args,result)}catch(e){await reportFailure(env,chatId,'mutation_verify',e,{tool,args})}if(m)m.verification_ms+=Date.now()-vs;if(!verified)result={...result,ok:false,verified:false,error:'mutation_postcondition_failed'};else result={...result,verified:true};}
    const now=nowIso(),jr=env.DB.prepare(`INSERT OR REPLACE INTO sanad_mutation_journal(operation_id,seq,chat_id,tool,state,before_json,after_json,error_text,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?)`).bind(operationId,seq,chatId,tool,result?.ok&&result?.verified?'applied':'failed',JSON.stringify(before).slice(0,50000),JSON.stringify(result?.after??result??{}).slice(0,50000),result?.ok?null:String(result?.error||'failed'),now,now),rr=env.DB.prepare(`INSERT OR REPLACE INTO sanad_receipts(operation_id,step_key,chat_id,tool,result_json,created_at) VALUES(?,?,?,?,?,?)`).bind(operationId,stepKey,chatId,tool,JSON.stringify(result).slice(0,15000),now),batch=[jr,rr];if(fpKey&&result?.ok&&result?.verified&&Number(result?.changed||0)>0)batch.push(env.DB.prepare(`INSERT OR IGNORE INTO sanad_receipts(operation_id,step_key,chat_id,tool,result_json,created_at) VALUES(?,?,?,?,?,?)`).bind(operationId,fpKey,chatId,tool,JSON.stringify(result).slice(0,15000),now));await env.DB.batch(batch);return result;
  }finally{if(m)m.tools_ms+=Math.max(0,Date.now()-started-(m.__toolInner||0));}
}

function retryIsoV128(attempts){const sec=Math.min(1800,Math.max(10,10*Math.pow(2,Math.min(7,Number(attempts||0)))));return new Date(Date.now()+sec*1000).toISOString();}
async function enqueueDeliveryV128(env,{key,chatId,kind='notification',text,keyboard=null,effect={},dueAt=null}){const now=nowIso();await env.DB.prepare(`INSERT OR IGNORE INTO sanad_delivery_queue(delivery_key,chat_id,kind,payload_text,keyboard_json,effect_json,state,attempts,next_retry_at,created_at,updated_at) VALUES(?,?,?,?,?,?,'pending',0,?,?,?)`).bind(String(key),String(chatId),String(kind),String(text),JSON.stringify(keyboard??null),JSON.stringify(effect||{}),dueAt||now,now,now).run();return env.DB.prepare(`SELECT * FROM sanad_delivery_queue WHERE delivery_key=?`).bind(String(key)).first();}
async function telegramDeliveryTransportV128(env,row){
  if(typeof env.__v128DeliveryTransport==='function')return env.__v128DeliveryTransport(row);
  const c=new AbortController(),timer=setTimeout(()=>c.abort(),8000);try{const body={chat_id:String(row.chat_id),text:String(row.payload_text)};const kb=parseJsonV125(row.keyboard_json,null);if(kb)body.reply_markup=kb;const r=await fetch(`https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/sendMessage`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body),signal:c.signal}),x=await r.json().catch(()=>null);if(!r.ok||!x?.ok)return{ok:false,definite:true,error:`telegram_http_${r.status}:${x?.description||''}`};return{ok:true,message_id:Number(x?.result?.message_id||0)};}catch(e){return{ok:false,uncertain:true,error:safeError(e)}}finally{clearTimeout(timer)}
}
async function effectStatementsV128(env,row,now){const e=parseJsonV125(row.effect_json,{}),a=[];switch(e.type){case'reminder':a.push(env.DB.prepare(`INSERT OR IGNORE INTO sanad_reminder_fires(reminder_id,fire_key,chat_id,sent_at) VALUES(?,?,?,?)`).bind(Number(e.id),String(row.delivery_key),String(row.chat_id),now));if(Number(e.offset||0)===0)a.push(env.DB.prepare(`UPDATE sanad_reminders SET sent=1,updated_at=? WHERE chat_id=? AND id=?`).bind(now,String(row.chat_id),Number(e.id)));break;case'recurrence':a.push(env.DB.prepare(`INSERT OR IGNORE INTO sanad_recurrence_fires(rule_id,occurrence_key,alert_offset,chat_id,sent_at) VALUES(?,?,?,?,?)`).bind(Number(e.id),String(e.occurrence_key),Number(e.offset||0),String(row.chat_id),now));if(Number(e.offset||0)===0)a.push(env.DB.prepare(`UPDATE sanad_recurrences SET fired_count=fired_count+1,updated_at=? WHERE chat_id=? AND id=?`).bind(now,String(row.chat_id),Number(e.id)));break;case'prayer':a.push(env.DB.prepare(`INSERT OR IGNORE INTO sanad_prayer_fires(rule_id,occurrence_date,chat_id,sent_at) VALUES(?,?,?,?)`).bind(Number(e.id),String(e.date),String(row.chat_id),now));a.push(env.DB.prepare(`UPDATE sanad_prayer_rules SET fired_count=fired_count+1,updated_at=? WHERE chat_id=? AND id=?`).bind(now,String(row.chat_id),Number(e.id)));break;case'brief':a.push(env.DB.prepare(`INSERT OR IGNORE INTO sanad_daily_brief_fires(chat_id,brief_date,brief_type,sent_at) VALUES(?,?,?,?)`).bind(String(row.chat_id),String(e.date),String(e.brief_type),now));break;case'live_watch':a.push(env.DB.prepare(`UPDATE sanad_live_watches SET last_url=?,updated_at=? WHERE chat_id=? AND id=?`).bind(String(e.url||''),now,String(row.chat_id),Number(e.id)));break;default:break;}a.push(env.DB.prepare(`INSERT OR IGNORE INTO sanad_proactive_fires(chat_id,fire_key,sent_at) VALUES(?,?,?)`).bind(String(row.chat_id),String(row.delivery_key),now));return a;}
async function processDeliveryRowV128(env,key){
  const now=nowIso(),lease=new Date(Date.now()+V128_DELIVERY_LEASE_MS).toISOString(),row=await env.DB.prepare(`UPDATE sanad_delivery_queue SET state='sending',attempts=attempts+1,lease_until=?,updated_at=? WHERE delivery_key=? AND state IN ('pending','retry') AND (next_retry_at IS NULL OR next_retry_at<=?) RETURNING *`).bind(lease,now,String(key),now).first();if(!row)return env.DB.prepare(`SELECT * FROM sanad_delivery_queue WHERE delivery_key=?`).bind(String(key)).first();
  const sent=await telegramDeliveryTransportV128(env,row);if(sent.ok){const done=env.DB.prepare(`UPDATE sanad_delivery_queue SET state='sent',lease_until=NULL,last_error=NULL,next_retry_at=NULL,telegram_message_id=?,sent_at=?,updated_at=?,duplicate_risk=0 WHERE delivery_key=?`).bind(Number(sent.message_id||0)||null,nowIso(),nowIso(),String(key)),effects=await effectStatementsV128(env,row,nowIso());await env.DB.batch([done,...effects]);return{...row,state:'sent',telegram_message_id:sent.message_id};}
  if(sent.uncertain){await env.DB.prepare(`UPDATE sanad_delivery_queue SET state='uncertain',lease_until=NULL,last_error=?,next_retry_at=NULL,updated_at=?,duplicate_risk=1 WHERE delivery_key=?`).bind(String(sent.error||'transport_uncertain'),nowIso(),String(key)).run();return{...row,state:'uncertain',error:sent.error};}
  await env.DB.prepare(`UPDATE sanad_delivery_queue SET state='retry',lease_until=NULL,last_error=?,next_retry_at=?,updated_at=? WHERE delivery_key=?`).bind(String(sent.error||'delivery_failed'),retryIsoV128(row.attempts),nowIso(),String(key)).run();return{...row,state:'retry',error:sent.error};
}
async function processDeliveryQueueV128(env,limit=V128_DELIVERY_BATCH){const now=nowIso();await env.DB.prepare(`UPDATE sanad_delivery_queue SET state='uncertain',lease_until=NULL,last_error=COALESCE(last_error,'worker_lost_while_sending'),duplicate_risk=1,updated_at=? WHERE state='sending' AND lease_until IS NOT NULL AND lease_until<=?`).bind(now,now).run();const rows=(await env.DB.prepare(`SELECT delivery_key FROM sanad_delivery_queue WHERE state IN ('pending','retry') AND (next_retry_at IS NULL OR next_retry_at<=?) ORDER BY created_at LIMIT ?`).bind(now,Math.max(1,Number(limit||V128_DELIVERY_BATCH))).all())?.results||[];let sent=0,retry=0,uncertain=0;for(const r of rows){const x=await processDeliveryRowV128(env,String(r.delivery_key));if(x?.state==='sent')sent++;else if(x?.state==='uncertain')uncertain++;else if(x?.state==='retry')retry++;}return{ok:true,processed:rows.length,sent,retry,uncertain};}
async function sendOnceV125(env,chatId,key,text){let kb=null;const m=String(key).match(/^rem:(\d+):/);if(m)kb={inline_keyboard:[[{text:'✅ تم',callback_data:`s126:rem:done:${m[1]}`},{text:'⏰ +10 د',callback_data:`s126:rem:snooze:${m[1]}:10`},{text:'🕐 +1 س',callback_data:`s126:rem:snooze:${m[1]}:60`}]]};const row=await enqueueDeliveryV128(env,{key,chatId,kind:'proactive',text,keyboard:kb});if(row?.state==='sent'||row?.state==='uncertain'||row?.state==='sending')return false;const done=await processDeliveryRowV128(env,key);return done?.state==='sent';}

async function deliverUserScheduleV125(env,u,lastMs,nowMs){const chatId=String(u.chat_id),ln=localNow(u.timezone||TZ),from=addDaysV125(ln.date,-1),to=addDaysV125(ln.date,1),one=(await env.DB.prepare(`SELECT * FROM sanad_reminders WHERE chat_id=? AND status='active' AND sent=0 AND local_date BETWEEN ? AND ?`).bind(chatId,from,to).all())?.results||[];for(const r of one){const main=localDateTimeApproxUtcMsV125(r.local_date,r.local_time,u.timezone||TZ),offsets=[0,...parseJsonV125(r.advance_json,[]),Number(r.advance_minutes||0)].map(Number).filter((v,i,a)=>v>=0&&a.indexOf(v)===i);for(const off of offsets){const fire=main-off*60000;if(fire<lastMs||fire>nowMs)continue;const key=`rem:${r.id}:${r.local_date}:${r.local_time}:${off}`,label=off?`⏰ تذكير مسبق (${off} دقيقة): ${r.title}`:`⏰ ${r.title}`,kb={inline_keyboard:[[{text:'✅ تم',callback_data:`s126:rem:done:${r.id}`},{text:'⏰ +10 د',callback_data:`s126:rem:snooze:${r.id}:10`},{text:'🕐 +1 س',callback_data:`s126:rem:snooze:${r.id}:60`}]]};await enqueueDeliveryV128(env,{key,chatId,kind:'reminder',text:label,keyboard:kb,effect:{type:'reminder',id:Number(r.id),offset:off}});}}
  const rules=(await env.DB.prepare(`SELECT * FROM sanad_recurrences WHERE chat_id=? AND active=1 AND start_date<=? AND (end_date IS NULL OR end_date>=?)`).bind(chatId,to,from).all())?.results||[];for(const r of rules){if(r.paused_until&&String(r.paused_until)>nowIso())continue;for(const o of generateRecurrenceOccurrencesV125(r,from,to,100)){const main=localDateTimeApproxUtcMsV125(o.date,o.time,u.timezone||TZ),offsets=[0,...parseJsonV125(r.advance_json,[])].map(Number).filter((v,i,a)=>v>=0&&a.indexOf(v)===i);for(const off of offsets){const fire=main-off*60000;if(fire<lastMs||fire>nowMs)continue;const key=`rec:${r.id}:${o.key}:${off}`;await enqueueDeliveryV128(env,{key,chatId,kind:'recurrence',text:off?`⏰ تذكير مسبق (${off} دقيقة): ${r.title}`:`🔁 ${r.title}`,effect:{type:'recurrence',id:Number(r.id),occurrence_key:o.key,offset:off}});}}}}
async function deliverPrayerRulesV125(env,u,lastMs,nowMs){const chatId=String(u.chat_id),ln=localNow(u.timezone||TZ),rules=(await env.DB.prepare(`SELECT * FROM sanad_prayer_rules WHERE chat_id=? AND active=1 AND start_date<=? AND (end_date IS NULL OR end_date>=?)`).bind(chatId,ln.date,ln.date).all())?.results||[];if(!rules.length)return;const data=await fetchPrayerTimesV125(env,u,ln.date);for(const r of rules){if(r.paused_until&&String(r.paused_until)>nowIso())continue;if(parseJsonV125(r.exceptions_json,[]).includes(ln.date))continue;const days=parseJsonV125(r.weekdays_json,[]).map(Number);if(days.length&&!days.includes(isoWeekdayV125(ln.date)))continue;const base=data.times[r.prayer];if(!base)continue;const shifted=addMinutesLocal(ln.date,base,Number(r.offset_minutes||0)),fire=localDateTimeApproxUtcMsV125(shifted.date,shifted.time,u.timezone||TZ);if(fire<lastMs||fire>nowMs)continue;await enqueueDeliveryV128(env,{key:`prayer:${r.id}:${ln.date}`,chatId,kind:'prayer',text:`🕌 ${r.title}`,effect:{type:'prayer',id:Number(r.id),date:ln.date}});}}
async function deliverDailyBriefsV125(env,u,lastMs,nowMs){const chatId=String(u.chat_id),tz=String(u.timezone||TZ),start=Number(lastMs||Date.now()-60000),end=Number(nowMs||Date.now());for(const type of ['morning','evening']){const enabled=Number(u[`${type}_brief_enabled`]||0),time=String(u[`${type}_brief_time`]||(type==='morning'?'08:00':'20:00'));if(!enabled||!validTimeV125(time))continue;const ln=localNow(tz),dates=[addDaysV125(ln.date,-1),ln.date];for(const date of dates){const fire=zonedLocalToEpochV125(date,time,tz);if(fire<start||fire>end)continue;await enqueueDeliveryV128(env,{key:`brief:${chatId}:${date}:${type}`,chatId,kind:'daily_brief',text:await buildBriefV125(env,u,type),effect:{type:'brief',date,brief_type:type}});}}}
async function checkLiveWatchesV125(env,cycle=null){let cursor=Number(cycle?.watch_cursor||0),complete=false,ok=true;for(let p=0;p<V128_WATCH_PAGES_PER_RUN;p++){const rows=(await env.DB.prepare(`SELECT * FROM sanad_live_watches WHERE active=1 AND id>? ORDER BY id LIMIT ?`).bind(cursor,V128_WATCH_PAGE_SIZE).all())?.results||[];if(!rows.length){complete=true;cursor=0;break;}for(const w of rows){cursor=Number(w.id);try{const news=await fetchNewsV125(w.query,3),top=news[0];if(top?.url&&top.url!==w.last_url){if(w.last_url)await enqueueDeliveryV128(env,{key:`watch:${w.id}:${fnv64V127(String(top.url))}`,chatId:String(w.chat_id),kind:'live_watch',text:`🛰️ جديد في متابعة "${w.query}":\n${top.title}\n${top.url}`,effect:{type:'live_watch',id:Number(w.id),url:String(top.url)}});else await env.DB.prepare(`UPDATE sanad_live_watches SET last_url=?,updated_at=? WHERE id=?`).bind(top.url,nowIso(),Number(w.id)).run();}}catch(e){ok=false;await reportFailure(env,String(w.chat_id),'live_watch',e,{watch_id:w.id})}}if(rows.length<V128_WATCH_PAGE_SIZE){complete=true;cursor=0;break;}}return{ok,complete,cursor};}

async function activeSchedulerCycleV128(env,scheduledTime){const existing=await env.DB.prepare(`SELECT * FROM sanad_scheduler_cycles WHERE state='active' ORDER BY created_at LIMIT 1`).first();if(existing)return existing;const end=Number(scheduledTime||Date.now()),lr=await env.DB.prepare(`SELECT value FROM sanad_scheduler_state WHERE key='last_run_ms'`).first(),start=Math.max(end-SCHEDULER_CATCHUP_MINUTES*60000,Number(lr?.value||end-60000)),id=`cycle:${start}:${end}:${crypto.randomUUID()}`;await env.DB.prepare(`INSERT INTO sanad_scheduler_cycles(cycle_id,cycle_start_ms,cycle_end_ms,user_cursor,watch_cursor,state,created_at,updated_at) VALUES(?,?,?,'',0,'active',?,?)`).bind(id,start,end,nowIso(),nowIso()).run();return env.DB.prepare(`SELECT * FROM sanad_scheduler_cycles WHERE cycle_id=?`).bind(id).first();}
async function runSanadScheduler(env,scheduledTime){await ensureV128Schema(env);await recoverStaleMutationTxV128(env);let c=await activeSchedulerCycleV128(env,scheduledTime),cursor=String(c.user_cursor||''),usersComplete=false,ok=true;for(let page=0;page<V128_USER_PAGES_PER_RUN;page++){const rows=(await env.DB.prepare(`SELECT * FROM sanad_users WHERE chat_id>? ORDER BY chat_id LIMIT ?`).bind(cursor,V128_USER_PAGE_SIZE).all())?.results||[];if(!rows.length){usersComplete=true;cursor='';break;}for(const u of rows){cursor=String(u.chat_id);try{await deliverUserScheduleV125(env,u,Number(c.cycle_start_ms),Number(c.cycle_end_ms));await deliverPrayerRulesV125(env,u,Number(c.cycle_start_ms),Number(c.cycle_end_ms));await deliverDailyBriefsV125(env,u,Number(c.cycle_start_ms),Number(c.cycle_end_ms));if(Number(u.proactive_enabled??1))await proactiveUserV125(env,u);}catch(e){ok=false;await reportFailure(env,String(u.chat_id),'scheduler_user',e,{cycle_id:c.cycle_id,window_start:c.cycle_start_ms,window_end:c.cycle_end_ms})}}if(rows.length<V128_USER_PAGE_SIZE){usersComplete=true;cursor='';break;}}
  let watch={ok:true,complete:false,cursor:Number(c.watch_cursor||0)};if(usersComplete)watch=await checkLiveWatchesV125(env,c);if(!watch.ok)ok=false;await processDeliveryQueueV128(env,V128_DELIVERY_BATCH);const done=usersComplete&&watch.complete&&ok,now=nowIso();if(done){await env.DB.batch([env.DB.prepare(`UPDATE sanad_scheduler_cycles SET state='complete',user_cursor='',watch_cursor=0,completed_at=?,updated_at=? WHERE cycle_id=?`).bind(now,now,String(c.cycle_id)),env.DB.prepare(`INSERT INTO sanad_scheduler_state(key,value,updated_at) VALUES('last_run_ms',?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at`).bind(String(c.cycle_end_ms),now)]);}else{await env.DB.prepare(`UPDATE sanad_scheduler_cycles SET user_cursor=?,watch_cursor=?,round_failures=round_failures+?,updated_at=? WHERE cycle_id=?`).bind(ok?cursor:'',usersComplete?Number(watch.cursor||0):Number(c.watch_cursor||0),ok?0:1,now,String(c.cycle_id)).run();}return{ok:done,complete:done,cycle_id:c.cycle_id,cycle_start_ms:Number(c.cycle_start_ms),cycle_end_ms:Number(c.cycle_end_ms),user_cursor:cursor,watch_cursor:Number(watch.cursor||0)};}
async function recoverStaleMutationTxV128(env){const cutoff=new Date(Date.now()-V128_TX_STALE_MS).toISOString(),rows=(await env.DB.prepare(`SELECT t.operation_id,t.chat_id,s.snapshot_json FROM sanad_mutation_tx t JOIN sanad_operation_snapshots s ON s.operation_id=t.operation_id AND s.chat_id=t.chat_id WHERE t.state='applying' AND t.started_at<? ORDER BY t.started_at LIMIT 10`).bind(cutoff).all())?.results||[];for(const r of rows)await recoverChatTransactionsV128(env,String(r.chat_id));}

async function drainInbox(env,chatId,origin=''){const owner=`lease-${crypto.randomUUID()}`;let acquired=false;for(let i=0;i<16;i++){if(await acquireLease(env,chatId,owner)){acquired=true;break}await sleep(550+Math.floor(Math.random()*100));}if(!acquired){if(origin)await triggerDrain(env,chatId,origin);return}let needsNext=false;try{const row=await nextInbox(env,chatId);if(!row)return;const now=nowIso(),until=new Date(Date.now()+Math.max(INBOX_LEASE_MS,AI_TOTAL_BUDGET_MS+20000)).toISOString(),claimed=await env.DB.prepare(`UPDATE sanad_inbox SET status='processing',attempts=attempts+1,lease_until=?,updated_at=? WHERE update_id=? AND chat_id=? AND (status='pending' OR lease_until IS NULL OR lease_until<=?) RETURNING attempts`).bind(until,now,String(row.update_id),String(chatId),now).first();if(!claimed)return;const attempts=Number(claimed.attempts||1);if(attempts>1)await env.DB.prepare(`DELETE FROM sanad_updates WHERE update_id=? AND status!='done'`).bind(String(row.update_id)).run();try{await processTelegramUpdate(env,JSON.parse(String(row.payload_json||'{}')));await env.DB.batch([env.DB.prepare(`UPDATE sanad_inbox SET status='done',lease_until=NULL,last_error=NULL,updated_at=? WHERE update_id=?`).bind(nowIso(),String(row.update_id)),env.DB.prepare(`DELETE FROM sanad_dead_letters WHERE update_id=?`).bind(String(row.update_id))]);}catch(e){const terminal=attempts>=INBOX_MAX_ATTEMPTS,err=safeError(e),next=new Date(Date.now()+Math.min(3600000,60000*Math.pow(2,Math.min(5,attempts)))).toISOString();if(terminal){await env.DB.batch([env.DB.prepare(`UPDATE sanad_inbox SET status='failed',lease_until=NULL,last_error=?,updated_at=? WHERE update_id=?`).bind(err,nowIso(),String(row.update_id)),env.DB.prepare(`INSERT INTO sanad_dead_letters(update_id,chat_id,payload_json,last_error,attempts,replay_count,state,next_replay_at,created_at,updated_at) VALUES(?,?,?,?,?,0,'dead',?,?,?) ON CONFLICT(update_id) DO UPDATE SET last_error=excluded.last_error,attempts=excluded.attempts,state='dead',next_replay_at=excluded.next_replay_at,updated_at=excluded.updated_at`).bind(String(row.update_id),String(chatId),String(row.payload_json||'{}'),err,attempts,next,nowIso(),nowIso())]);}else await env.DB.prepare(`UPDATE sanad_inbox SET status='pending',lease_until=NULL,last_error=?,updated_at=? WHERE update_id=?`).bind(err,nowIso(),String(row.update_id)).run();await reportFailure(env,chatId,'inbox',e,{update_id:row.update_id,attempts,terminal});}finally{needsNext=!!(await nextInbox(env,chatId));}}finally{await releaseLease(env,chatId,owner).catch(e=>console.error('releaseLease',e))}if(needsNext&&origin)await triggerDrain(env,chatId,origin);}
async function replayDueDeadLettersV128(env){const rows=(await env.DB.prepare(`SELECT * FROM sanad_dead_letters WHERE state='dead' AND replay_count<? AND next_replay_at IS NOT NULL AND next_replay_at<=? ORDER BY next_replay_at LIMIT 20`).bind(V128_DLQ_AUTO_REPLAYS,nowIso()).all())?.results||[];for(const r of rows){await env.DB.batch([env.DB.prepare(`UPDATE sanad_inbox SET status='pending',attempts=0,lease_until=NULL,last_error=NULL,updated_at=? WHERE update_id=?`).bind(nowIso(),String(r.update_id)),env.DB.prepare(`UPDATE sanad_dead_letters SET state='replaying',replay_count=replay_count+1,last_replayed_at=?,updated_at=? WHERE update_id=?`).bind(nowIso(),nowIso(),String(r.update_id))]);await drainInbox(env,String(r.chat_id));}}
async function recoverPendingInbox(env){for(let round=0;round<V127_RECOVERY_ROUNDS;round++){const rows=(await env.DB.prepare(`SELECT chat_id,MIN(created_at) first_at FROM sanad_inbox WHERE status='pending' OR (status='processing' AND (lease_until IS NULL OR lease_until<=?)) GROUP BY chat_id ORDER BY first_at,chat_id LIMIT ?`).bind(nowIso(),V127_RECOVERY_PAGE_SIZE).all())?.results||[];if(!rows.length)break;for(const r of rows)await drainInbox(env,String(r.chat_id));if(rows.length<V127_RECOVERY_PAGE_SIZE)break;}await replayDueDeadLettersV128(env);}
async function deadLetterAdminV128(request,env,ctx,url){if(!env.SETUP_KEY||!secureEq(adminKey(request),env.SETUP_KEY))return j({ok:false,error:'Unauthorized'},401);await ensureSchema(env);if(request.method==='GET'){const rows=(await env.DB.prepare(`SELECT update_id,chat_id,last_error,attempts,replay_count,state,next_replay_at,updated_at FROM sanad_dead_letters ORDER BY updated_at DESC LIMIT 200`).all())?.results||[];return j({ok:true,items:rows});}const body=await safeRequestJson(request),ids=[...(body?.update_ids||[])].map(String).filter(Boolean).slice(0,100);if(!ids.length)return j({ok:false,error:'missing_update_ids'},400);const chats=new Set();for(const id of ids){const r=await env.DB.prepare(`SELECT chat_id FROM sanad_dead_letters WHERE update_id=?`).bind(id).first();if(!r)continue;chats.add(String(r.chat_id));await env.DB.batch([env.DB.prepare(`UPDATE sanad_inbox SET status='pending',attempts=0,lease_until=NULL,last_error=NULL,updated_at=? WHERE update_id=?`).bind(nowIso(),id),env.DB.prepare(`UPDATE sanad_dead_letters SET state='replaying',replay_count=replay_count+1,last_replayed_at=?,updated_at=? WHERE update_id=?`).bind(nowIso(),nowIso(),id)]);}for(const chat of chats)ctx.waitUntil(drainInbox(env,chat,url.origin));return j({ok:true,replayed:ids.length,chats:[...chats]});}
async function deliveryReplayAdminV128(request,env){if(!env.SETUP_KEY||!secureEq(adminKey(request),env.SETUP_KEY))return j({ok:false,error:'Unauthorized'},401);const body=await safeRequestJson(request),keys=[...(body?.delivery_keys||[])].map(String).filter(Boolean).slice(0,100);for(const key of keys)await env.DB.prepare(`UPDATE sanad_delivery_queue SET state='retry',duplicate_risk=CASE WHEN state='uncertain' THEN 1 ELSE duplicate_risk END,next_retry_at=?,lease_until=NULL,updated_at=? WHERE delivery_key=? AND state IN ('uncertain','retry','pending')`).bind(nowIso(),nowIso(),key).run();const r=await processDeliveryQueueV128(env,Math.max(1,keys.length));return j({ok:true,requested:keys.length,result:r});}

function percentileV128(values,p){if(!values.length)return 0;const a=[...values].sort((x,y)=>x-y),i=Math.min(a.length-1,Math.max(0,Math.ceil(p*a.length)-1));return a[i];}
async function diagnosticsV128(request,env){if(!env.SETUP_KEY||!secureEq(adminKey(request),env.SETUP_KEY))return j({ok:false,error:'Unauthorized'},401);await ensureSchema(env);const now=Date.now(),[models,failures,inbox,deliveries,cycle,dlq,metrics,failedMut,rb]=await Promise.all([env.DB.prepare(`SELECT model_id,attempts,successes,failures,last_latency_ms,last_error,updated_at FROM sanad_model_stats ORDER BY model_id`).all().then(x=>x?.results||[]),env.DB.prepare(`SELECT scope,error_text,created_at FROM sanad_failures ORDER BY id DESC LIMIT 30`).all().then(x=>x?.results||[]),env.DB.prepare(`SELECT status,COUNT(*) c,MIN(created_at) oldest FROM sanad_inbox GROUP BY status`).all().then(x=>x?.results||[]),env.DB.prepare(`SELECT state,COUNT(*) c,MIN(created_at) oldest FROM sanad_delivery_queue GROUP BY state`).all().then(x=>x?.results||[]),env.DB.prepare(`SELECT * FROM sanad_scheduler_cycles WHERE state='active' ORDER BY created_at LIMIT 1`).first(),env.DB.prepare(`SELECT COUNT(*) c FROM sanad_dead_letters WHERE state IN ('dead','replaying')`).first(),env.DB.prepare(`SELECT total_ms,context_ms,planning_ms,tools_ms,verification_ms,compose_ms,d1_queries,ai_calls,tool_calls,context_bytes,budget_exceeded FROM sanad_operation_metrics ORDER BY created_at DESC LIMIT 200`).all().then(x=>x?.results||[]),env.DB.prepare(`SELECT COUNT(*) c FROM sanad_mutation_journal WHERE state='failed'`).first(),env.DB.prepare(`SELECT COUNT(*) c FROM sanad_failures WHERE scope LIKE 'atomic_rollback%' OR scope LIKE '%mutation_recovery%'`).first()]);const lat=metrics.map(x=>Number(x.total_ms||0)),avg=k=>metrics.length?Math.round(metrics.reduce((n,x)=>n+Number(x[k]||0),0)/metrics.length):0,pending=inbox.find(x=>x.status==='pending'),oldestAge=pending?.oldest?Math.max(0,now-Date.parse(String(pending.oldest))):0,schedulerLag=cycle?Math.max(0,now-Number(cycle.cycle_end_ms||now)):0;return j({ok:true,version:VERSION,architecture:'atomic-runtime',tools:Object.keys(TOOL_SPECS).length,inbox,inbox_pending:Number(pending?.c||0),oldest_inbox_age_ms:oldestAge,deliveries,delivery_failures:deliveries.filter(x=>['retry','uncertain'].includes(String(x.state))),dead_letters:Number(dlq?.c||0),scheduler:{active_cycle:cycle||null,lag_ms:schedulerLag},mutations:{failed:Number(failedMut?.c||0),rollback_failures:Number(rb?.c||0)},performance:{samples:metrics.length,average_ms:avg('total_ms'),p95_ms:percentileV128(lat,0.95),average_context_ms:avg('context_ms'),average_planning_ms:avg('planning_ms'),average_tools_ms:avg('tools_ms'),average_verification_ms:avg('verification_ms'),average_compose_ms:avg('compose_ms'),average_d1_queries:avg('d1_queries'),average_context_bytes:avg('context_bytes'),average_tool_calls:avg('tool_calls'),budget_exceeded:metrics.filter(x=>Number(x.budget_exceeded)).length},models,failures});}
