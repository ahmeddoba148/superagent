{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superagent-v107-staging",
  "main": "./SuperAgent_V10_7_Universal_Agent.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "PUBLIC_BOT": "false",
    "V107_STAGING_BUILD": "semantic-first-universal"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "superagent-v106-staging",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],
  "services": [
    {
      "binding": "OMNIAI_SERVICE",
      "service": "omniai-engine"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
